# Supabase — get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Used for seeding/admin tasks. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site URL (used for auth redirects). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When the NEXT_PUBLIC_SUPABASE_* vars are absent, the app runs in
# in-memory DEMO MODE (seeded from the prototype data) so it always works.
